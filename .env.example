# Credenciais do Postgres usadas pelo Docker Compose (containers `postgres` e `api`).
# Fonte única para usuário/senha/porta do banco — troque aqui em vez de editar o
# docker-compose.yml.
#
# Atenção: de fora do Docker (scripts rodados no host, Beekeeper Studio, etc.) o
# Postgres é acessado por localhost:DB_PORT, não pelo nome do serviço `postgres`.
# Por isso apps/api/.env continua com sua própria DATABASE_URL — mantenha o
# usuário/senha/porta dela iguais aos valores abaixo.
POSTGRES_USER=hortierp
POSTGRES_PASSWORD=hortierp
POSTGRES_DB=hortierp_lite
DB_PORT=5433
