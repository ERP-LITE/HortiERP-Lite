{
  "name": "hortierp-lite",
  "private": true,
  "version": "0.1.0",
  "description": "HortiERP Lite - sistema modular de controle de estoque para hortifrutis e pequenos mercados",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build:api": "npm run build --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "test": "npm test --workspace=apps/api",
    "test:load": "sh scripts/run-load-test.sh",
    "db:generate": "npm run db:generate --workspace=apps/api",
    "db:migrate": "npm run db:migrate --workspace=apps/api",
    "db:seed": "npm run db:seed --workspace=apps/api",
    "db:seed:platform": "npm run db:seed:platform --workspace=apps/api"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "vite": "^8.2.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
