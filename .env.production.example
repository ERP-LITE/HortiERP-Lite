# Domínio público apontado para o servidor, sem https:// e sem barra final.
APP_DOMAIN=erp.exemplo.com

# Use valores longos, aleatórios e sem caracteres que precisem de URL encoding.
POSTGRES_USER=hortierp_prod
POSTGRES_PASSWORD=troque-por-uma-senha-aleatoria-forte
POSTGRES_DB=hortierp_prod

# Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=8h

# Limite por XML, PDF ou imagem anexada à nota fiscal (10 MB em bytes).
INVOICE_MAX_FILE_SIZE=10485760

# Backup local diário, criptografado, com retenção de 30 dias.
# Gere uma senha independente do JWT e guarde uma cópia fora do servidor.
BACKUP_ENCRYPTION_PASSWORD=troque-por-uma-senha-de-criptografia-forte
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30

# Armazenamento externo S3 compatível (AWS S3, Cloudflare R2, Backblaze etc.).
# Deixe BACKUP_REMOTE_PATH vazio somente enquanto estiver configurando o servidor.
BACKUP_REMOTE_PATH=erp-lite/production
RCLONE_CONFIG_STORAGE_TYPE=s3
RCLONE_CONFIG_STORAGE_PROVIDER=Other
RCLONE_CONFIG_STORAGE_ACCESS_KEY_ID=troque-pela-access-key
RCLONE_CONFIG_STORAGE_SECRET_ACCESS_KEY=troque-pela-secret-key
RCLONE_CONFIG_STORAGE_ENDPOINT=https://seu-endpoint-s3

# Sinal de vida para um monitor externo (healthchecks.io ou equivalente): o
# backup chama essa URL toda vez que termina bem, e o próprio monitor avisa se
# o sinal parar de chegar. Deixe vazio para não notificar ninguém.
BACKUP_HEARTBEAT_URL=

# --- Retenção de dados pessoais (LGPD) ---
# Todas as três são OPCIONAIS: se não existirem no arquivo, o sistema usa exatamente
# estes valores. Só declare se for mudar algum.
#
# Prazo do log técnico, que guarda data, hora e IP de cada requisição. 180 dias é o
# piso do Marco Civil da Internet (art. 15) e a API RECUSA INICIAR com valor menor —
# encurtar não é economia de espaço, é descumprir a lei.
TECHNICAL_LOG_RETENTION_DAYS=180
# Prazo da trilha de auditoria e da anonimização de usuário excluído. Acompanha o
# prazo de fiscalização tributária: 5 anos.
AUDIT_RETENTION_DAYS=1825
# Intervalo entre execuções do contêiner `retention`, em segundos. Padrão: 1 semana.
RETENTION_INTERVAL_SECONDS=604800

