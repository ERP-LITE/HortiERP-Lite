{
  "name": "@hortierp/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:platform": "tsx src/db/seedPlatform.ts",
    "invoices:cleanup": "tsx src/scripts/cleanupInvoiceOrphans.ts",
    "data:retention": "tsx src/scripts/retentionPurge.ts",
    "alert:errors": "tsx src/scripts/errorRateAlert.ts",
    "data:erase-company": "tsx src/scripts/eraseCompany.ts",
    "test": "sh scripts/test-integration.sh",
    "test:run": "tsx --test --test-concurrency=1 tests/**/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.1",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.15",
    "@types/pg": "^8.11.6",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^11.2.2",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4"
  }
}
