# Servidor
PORT=3333
NODE_ENV=development

# Banco de dados
# Usuário/senha/porta devem bater com o .env da raiz do repo (usado pelo Docker Compose) —
# aqui é o acesso pelo host (localhost), lá é o acesso entre containers.
DATABASE_URL=postgres://hortierp:hortierp@localhost:5433/hortierp_lite
# Papel sem superusuário usado pela API. Criado por `npm run db:migrate`. Se ficar vazia, a API
# cai em DATABASE_URL e avisa no console — em produção isso é recusado.
APP_DATABASE_URL=postgres://hortierp_app:hortierp_app@localhost:5433/hortierp_lite
DATABASE_POOL_MAX=20

# Autenticação
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# CORS
CORS_ORIGIN=http://localhost:5173

# Endereco, faixa CIDR ou lista de quem pode falar pela API, ou `false` quando ela recebe a
# conexao direto. Em producao com o gateway padrao (Caddy) o valor e `uniquelocal`, que cobre as
# faixas privadas onde os containers vivem. Dois valores sao recusados de proposito: `true`, que
# faria o Fastify aceitar o X-Forwarded-For que o cliente escreveu (e o limite de tentativas de
# login por IP deixaria de valer, bastaria trocar o cabecalho a cada tentativa), e um numero de
# saltos, que desde o Fastify 5.12 recusa todos os peers e vale o mesmo que `false`, sem avisar.
TRUST_PROXY=false

# Envio de e-mail (Resend). Hoje o unico e-mail que o sistema manda e o de redefinicao de senha.
# Sem RESEND_API_KEY o envio nao acontece: a mensagem e o link vao para o log do servidor, o que
# permite testar o fluxo inteiro na maquina sem conta na Resend e sem mandar e-mail a ninguem.
# Em producao o env.ts recusa subir sem as duas variaveis.
# MAIL_FROM precisa ser de um dominio verificado na Resend. O remetente de exemplo
# `onboarding@resend.dev` so entrega para o e-mail do dono da conta, entao nao serve para cliente.
RESEND_API_KEY=
MAIL_FROM=

# Base do link que vai no e-mail. Vazio cai na primeira origem do CORS_ORIGIN, que em producao e o
# proprio endereco publico do sistema.
APP_PUBLIC_URL=

# Validade do link de redefinicao e carencia entre dois pedidos da mesma conta, em minutos.
PASSWORD_RESET_TTL_MINUTES=60
PASSWORD_RESET_COOLDOWN_MINUTES=2

# Anexos privados das notas fiscais (XML, PDF e imagens).
INVOICE_STORAGE_PATH=./storage/invoices
INVOICE_MAX_FILE_SIZE=10485760

# Retenção de dados pessoais (dias). Aplicados pelo script `npm run data:retention`.
# TECHNICAL_LOG_RETENTION_DAYS não aceita menos de 180: é o piso do Marco Civil, art. 15.
TECHNICAL_LOG_RETENTION_DAYS=180
AUDIT_RETENTION_DAYS=1825
# Intervalo entre execuções do serviço `retention` em produção (segundos). Padrão: uma semana.
RETENTION_INTERVAL_SECONDS=604800
# Sinal de vida para monitor externo. Vazio em desenvolvimento.
RETENTION_HEARTBEAT_URL=

# Alerta de erro de servidor: vigia system_logs e avisa o monitor quando aparece 5xx.
# Vazio em desenvolvimento (o script registra que não há nada a vigiar e sai).
ERROR_ALERT_HEARTBEAT_URL=
ERROR_ALERT_INTERVAL_SECONDS=900
ERROR_ALERT_THRESHOLD=1
