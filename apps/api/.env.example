# Servidor
PORT=3333
NODE_ENV=development

# Banco de dados
# Usuário/senha/porta devem bater com o .env da raiz do repo (usado pelo Docker Compose) —
# aqui é o acesso pelo host (localhost), lá é o acesso entre containers.
DATABASE_URL=postgres://hortierp:hortierp@localhost:5433/hortierp_lite

# Autenticação
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# Cloudflare Turnstile (login)
# Valor abaixo é a chave de teste da Cloudflare que sempre passa (uso só em dev).
# Troque pela secret key real do seu site em produção: https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# CORS
CORS_ORIGIN=http://localhost:5173
